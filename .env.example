# Copy this file to .env and fill in only what you use.
# .env is never committed to git. Never share its contents.

# Hygraph — Project Settings -> API Access -> Content API (Content Delivery API URL).
# Leave empty to keep the clearly labelled demonstration content.
HYGRAPH_ENDPOINT=https://ap-south-1.cdn.hygraph.com/content/cmuxpm3ll0qls06uyeueivu3g/master

# Optional: only needed when your model API IDs differ from the ones below.
HYGRAPH_NEWS_MODEL=actualites
HYGRAPH_EVENT_MODEL=evenements
HYGRAPH_ANNOUNCEMENT_MODEL=annonces
HYGRAPH_GALLERY_MODEL=galeries
HYGRAPH_VIDEO_MODEL=videos

# Alternative editorial workspace: your own WordPress site address.
# Used only when HYGRAPH_ENDPOINT is empty. Example: https://cms.drac-plateaux.tg
WORDPRESS_URL=
